#!/bin/sh
# git credential helper for Gitea (Configure External Services → Gitea).
#
# The package's system git config (/etc/gitconfig, rewritten at every start)
# names this helper for the Gitea URL only. For "get" it prints the access
# token as the password: Gitea signs in as the token's owner, whatever the
# username. The token comes from getcred (typed in, or Vaultwarden item
# "gitea", field "api_key") at every request and is never stored; git's
# "store"/"erase" requests are ignored. If the token can't be read, getcred's
# reason is shown and git carries on without it (and then fails to sign in).
[ "$1" = get ] || exit 0
cat >/dev/null # git's request (protocol, host, ...) on stdin; not needed
if value=$(getcred GITEA_KEY); then
  printf 'username=openclaw\npassword=%s\n' "$value"
fi
exit 0
