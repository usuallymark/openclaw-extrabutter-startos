#!/bin/sh
# getcred VAR — print a credential configured in Configure External Services.
#
# If VAR is set in the environment ("Enter manually"), print it.
# Otherwise, if VAR_FROM_VAULT is set ("Fetch from Vaultwarden", value
# "<entry>:<field>"), fetch that field from the vault service and print it.
# The value is printed without a trailing newline. Exits non-zero, with a
# message on stderr only, if the credential is not configured or the lookup
# fails. When this shell has neither variable (e.g. a root attach shell),
# both are read from the running gateway process. The vault service syncs
# once and looks again on a miss, so vault edits are picked up without a
# manual sync. Secrets never appear in error messages.
set -u

usage() {
  echo "usage: getcred VAR   (e.g. getcred NAS_PASS)" >&2
  exit 2
}

[ $# -eq 1 ] || usage
var=$1
case $var in
  '' | *[!A-Za-z0-9_]* | [0-9]*) usage ;;
esac

# Service settings live in the environment of the OpenClaw gateway and of
# everything it starts. A shell started another way (a root attach shell, a
# git hook) lacks them; then read them from the running gateway process (the
# one started with OPENCLAW_HEALTH_TARGETS).
gateway_environ_file() {
  for f in /proc/[0-9]*/environ; do
    [ "$f" = "/proc/$$/environ" ] && continue
    if tr '\000' '\n' 2>/dev/null < "$f" | grep -q '^OPENCLAW_HEALTH_TARGETS='; then
      echo "$f"
      return 0
    fi
  done
  return 1
}
gateway_value() {
  tr '\000' '\n' 2>/dev/null < "$gw" | sed -n "s/^$1=//p" | head -n 1
}

eval "plain=\${$var-}"
eval "pointer=\${${var}_FROM_VAULT-}"
gw=
if [ -z "$plain" ] && [ -z "$pointer" ]; then
  if gw=$(gateway_environ_file); then
    plain=$(gateway_value "$var")
    [ -n "$plain" ] || pointer=$(gateway_value "${var}_FROM_VAULT")
  else
    echo "getcred: $var is not set here, and no running OpenClaw gateway this user can read was found (is OpenClaw running? try as root or node)" >&2
    exit 1
  fi
fi
if [ -n "$plain" ]; then
  printf '%s' "$plain"
  exit 0
fi
if [ -z "$pointer" ]; then
  echo "getcred: $var is not configured: neither $var nor ${var}_FROM_VAULT is set here or in the gateway process (enable the service in Configure External Services)" >&2
  exit 1
fi

entry=${pointer%%:*}
field=${pointer#*:}
if [ -z "$entry" ] || [ "$field" = "$pointer" ] || [ -z "$field" ]; then
  echo "getcred: ${var}_FROM_VAULT must look like <entry>:<field>" >&2
  exit 1
fi

# The vault belongs to the vault service (since 2026.10.1:27); ask it. It
# matches item names without regard to case (and field names always), syncs
# once with Vaultwarden on a miss, and refuses items that belong to a
# service (the email password, the Calendar sign-in, calendar links).
# Errors carry its reason, never the secret.
if ! value=$(/usr/local/bin/vault-client get "$entry" "$field"); then
  # vault-client printed why (prefixed "vault: ") on stderr.
  exit 1
fi
if [ -z "$value" ]; then
  echo "getcred: Vaultwarden entry \"$entry\", field \"$field\" is empty ($var)" >&2
  exit 1
fi
printf '%s' "$value"
